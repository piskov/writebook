<dialog class="lightbox" aria-label="Просмотр изображения (Esc — закрыть)" data-lightbox-target="dialog" data-action="close->lightbox#reset">
  <img src="" class="lightbox__image" data-lightbox-target="zoomedImage" />

  <form method="dialog" class="lightbox__btn">
    <button class="btn fill-white" title="Закрыть (Esc)">
      <%= image_tag "remove.svg", aria: { hidden: "true" } %>
      <span class="for-screen-reader">Закрыть изображение (Esc)</span>
    </button>
  </form>
</dialog>
